# /etc/basharnia/backup.env  (chmod 600, root only)

# PUBLIC key of an age key pair. The matching PRIVATE key must NOT be stored on
# this server: keep it offline (password manager / USB) — it is needed to restore.
#   age-keygen -o basharnia-backup.key   # on your own computer; prints the public key
AGE_RECIPIENT=age1...

# Off-site copy with rclone (configure the remote first: `rclone config`).
# Empty = local copies only — NOT enough: the backup policy requires an off-site copy.
RCLONE_REMOTE=offsite:basharnia-backups

KEEP_DAILY=7
KEEP_WEEKLY=4
WEEKLY_DAY=5          # ISO weekday of the weekly copy (5 = Friday)

APP_DIR=/opt/basharnia
BACKUP_DIR=/var/backups/basharnia
STORAGE_PATH=/data/basharnia
