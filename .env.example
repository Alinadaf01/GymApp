# Copy to .env and fill in. NEVER commit .env. No real secrets in this file.

APP_ENV=production
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://basharnia:CHANGE_ME@db:5432/basharnia
# One domain serves the panel (/) and the API (/api) — all three must match it
FRONTEND_URL=https://coach.example.com
API_BASE_URL=https://coach.example.com

# docker-compose only
POSTGRES_DB=basharnia
POSTGRES_USER=basharnia
POSTGRES_PASSWORD=
DOMAIN=coach.example.com
STORAGE_HOST_PATH=/data/basharnia

# Used only once by `python -m app.cli create-admin`; remove after first setup
ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# From @BotFather. Never commit it.
TELEGRAM_BOT_TOKEN=
# The coach's numeric Telegram user id (not the @username)
TELEGRAM_ALLOWED_USER_ID=
# Random, 24+ chars: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/models
# Exercise-name hint for Whisper; keep false until evaluated with real voices
WHISPER_VOCAB_HINT=true
AUDIO_MAX_DURATION_SECONDS=900
# Raw voice files are deleted after processing (0). Set hours to keep them longer.
AUDIO_RETAIN_HOURS=0

STORAGE_ROOT=/data/basharnia
MAX_UPLOAD_MB=20

TIMEZONE=Asia/Tehran

# Auth
SESSION_TTL_HOURS=168
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
