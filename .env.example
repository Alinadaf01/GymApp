# Copy to .env and fill in. NEVER commit .env. No real secrets in this file.

APP_ENV=production
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://basharnia:CHANGE_ME@db:5432/basharnia
FRONTEND_URL=https://coach.example.com
API_BASE_URL=https://api.example.com

# docker-compose only
POSTGRES_DB=basharnia
POSTGRES_USER=basharnia
POSTGRES_PASSWORD=
API_DOMAIN=api.example.com
STORAGE_HOST_PATH=/data/basharnia

# Used only once by `python -m app.cli create-admin`; remove after first setup
ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_MAX_DURATION_SECONDS=900

STORAGE_ROOT=/data/basharnia
MAX_UPLOAD_MB=20

TIMEZONE=Asia/Tehran

# Auth
SESSION_TTL_HOURS=168
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
